{
  "name": "tideaware",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "concurrently --names web,api --prefix-colors cyan,green \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "next dev",
    "dev:api": "node scripts/dev-api.mjs",
    "prebuild": "rimraf .next-build",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "geotiff": "^3.0.5",
    "maplibre-gl": "6.17.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "^29.1.1",
    "rimraf": "6.1.4",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  }
}
